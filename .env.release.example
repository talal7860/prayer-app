# Copy to .env.release (git-ignored) and fill in. scripts/release.sh reads it.
# Keep the key files themselves outside the repo too.

# App Store Connect API key (iOS upload, and EAS signing without an Apple ID login).
ASC_API_KEY_ID=
ASC_API_ISSUER_ID=
ASC_API_KEY_PATH=$HOME/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8

# Google Play service account JSON (Android upload).
PLAY_SERVICE_ACCOUNT_JSON=$HOME/.config/adhan-app/play-service-account.json

# The Apple team id (App Store Connect → Membership). Required for iOS; kept out of the repo.
EXPO_APPLE_TEAM_ID=
EXPO_APPLE_TEAM_TYPE=COMPANY_OR_ORGANIZATION
