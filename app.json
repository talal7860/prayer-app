{
  "expo": {
    "name": "Prayer Times",
    "slug": "prayer-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "org.personal.talal7860.PrayerTimes",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Location Services required for fetching city and country",
        "UIViewControllerBasedStatusBarAppearance": false
      }
    },
    "android": {
      "package": "com.talal7860.prayertimes",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundImage": "./assets/images/adaptive-icon-background.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#2453B3"
      },
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/makkah_azan.mp3"
          ],
          "color": "#ffffff"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Location Services required for fetching city and country"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#2453B3",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0D1120"
          }
        }
      ],
      "expo-background-task"
    ],
    "extra": {
      "eas": {
        "projectId": "8deab7ae-9106-4150-b064-87578c79a68e"
      }
    }
  }
}
