{
  "expo": {
    "name": "Adhan Times",
    "slug": "prayer-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.conelabs.adhanapp",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Location Services required for fetching city and country",
        "UIViewControllerBasedStatusBarAppearance": false,
        "UIBackgroundModes": ["fetch", "processing"],
        "INAlternativeAppNames": [
          {
            "INAlternativeAppName": "Adhan"
          }
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      },
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.conelabs.adhanapp"],
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.conelabs.adhanapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundImage": "./assets/images/adaptive-icon-background.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#2453B3"
      },
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/makkah_azan.wav",
            "./assets/sounds/adhan_madinah.wav",
            "./assets/sounds/adhan_aqsa.wav",
            "./assets/sounds/adhan_fajr.wav"
          ],
          "color": "#ffffff",
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is used to calculate prayer times for where you are.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#2453B3",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0D1120"
          }
        }
      ],
      "expo-background-task",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.conelabs.adhanapp.widget",
          "groupIdentifier": "group.com.conelabs.adhanapp",
          "enableAndroid": true,
          "widgets": [
            {
              "name": "NextPrayer",
              "displayName": "Next prayer",
              "description": "The next prayer with a live countdown, the sky and the day's times.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              },
              "android": {
                "minWidth": 250,
                "minHeight": 110,
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "resizeMode": "both"
              }
            },
            {
              "name": "PrayerRing",
              "displayName": "Prayer ring",
              "description": "Time left to the next prayer, as a ring.",
              "ios": {
                "supportedFamilies": ["systemSmall", "accessoryCircular"]
              },
              "android": null
            }
          ]
        }
      ],
      "expo-sharing",
      "expo-localization",
      "@bacons/apple-targets"
    ],
    "extra": {
      "eas": {
        "projectId": "8deab7ae-9106-4150-b064-87578c79a68e"
      },
      "supportsRTL": true
    },
    "locales": {
      "en": "./app/locales/native/en.json",
      "ar": "./app/locales/native/ar.json",
      "ur": "./app/locales/native/ur.json"
    }
  }
}
