+/**
+ * A countdown the system ticks every second (RemoteViews Chronometer), to the time in `at`
+ * (ms since the epoch). Props: at, color ("#RRGGBB"), fontSize (sp). When it reaches zero,
+ * WidgetTicker re-renders the widgets so the layout can move on.
+ */
+private fun ReadableMap.toPeekChronometer(converterContext: WidgetConverterContext): Emittable {
+  val props = propsMap()
+  fun double(key: String): Double? =
+    if (props != null && props.hasKey(key) && !props.isNull(key)) props.getDouble(key) else null
+  fun string(key: String): String? =
+    if (props != null && props.hasKey(key) && !props.isNull(key)) props.getString(key) else null
+
+  val context = converterContext.applicationContext
+  val at = double("at")?.toLong() ?: System.currentTimeMillis()
+  val viewId = R.id.expo_widgets_chronometer
+  val views = android.widget.RemoteViews(context.packageName, R.layout.expo_widgets_chronometer)
+  val base = android.os.SystemClock.elapsedRealtime() + (at - System.currentTimeMillis())
+  views.setChronometer(viewId, base, null, true)
+  views.setChronometerCountDown(viewId, true)
+  string("color")?.let { color ->
+    runCatching { android.graphics.Color.parseColor(color) }.getOrNull()?.let { views.setTextColor(viewId, it) }
+  }
+  double("fontSize")?.let { views.setTextViewTextSize(viewId, android.util.TypedValue.COMPLEX_UNIT_SP, it.toFloat()) }
+  WidgetTicker.schedule(context, at + 1000)
+  // Glance's EmittableAndroidRemoteViews is Kotlin-internal (public in the bytecode), so it's
+  // created and filled through reflection.
+  val emittableClass = Class.forName("androidx.glance.appwidget.EmittableAndroidRemoteViews")
+  val emittable = emittableClass.getDeclaredConstructor().newInstance() as Emittable
+  emittableClass.getMethod("setRemoteViews", android.widget.RemoteViews::class.java).invoke(emittable, views)
+  // Size it like other views (e.g. fillMaxWidth), or the text gets clipped to its first width.
+  emittable.modifier = props<LayoutProps>(converterContext).modifiers.toPeekModifier(converterContext)
+  return emittable
+}
